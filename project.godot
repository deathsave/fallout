; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="fallout"
config/description="Fallout pinball - Godot Media Controller (GMC) for MPF 0.80"
run/main_scene="res://window.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

MPF="*res://addons/mpf-gmc/mpf_gmc.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; The Ubuntu cabinet (replaces old kivy_config fullscreen/borderless settings)
window/size/mode.linuxbsd=3
window/size/borderless.linuxbsd=true
; display2 (VATS) lives in a real OS window on the second monitor
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/mpf-gmc/plugin.cfg")

[rendering]

; Compatibility (OpenGL) renderer: plenty for a 2D pinball display, and the
; Vulkan/Forward+ renderer hangs at window creation on some Macs (AMD GPU).
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[filesystem]

import/blender/enabled=false
